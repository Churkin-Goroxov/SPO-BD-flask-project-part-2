/* =========================================================
   PAYMENT PAGE
   ========================================================= */

.payment-page {
    padding-top: 32px;
}

.payment-page__heading {
    margin-bottom: 32px;
}

.payment-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 32px;
    align-items: start;
}

.payment-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.payment-method-card {
    padding: 28px;
}

.payment-methods {
    display: grid;
    gap: 12px;
    margin-top: 24px;
}

.payment-method {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    text-align: left;
    cursor: pointer;
    transition: 0.2s ease;
}

.payment-method:hover,
.payment-method.is-selected {
    border-color: var(--accent);
    background: var(--background);
}

.payment-method__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 9px;
    font-size: 11px;
    font-weight: 700;
}

.payment-method__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.payment-method__content small {
    color: var(--text-secondary);
    font-size: 13px;
}

.payment-method__check {
    opacity: 0;
    color: var(--accent);
    font-weight: 700;
}

.payment-method.is-selected .payment-method__check {
    opacity: 1;
}

.payment-card-form {
    margin-top: 28px;
}

.payment-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.payment-test-note {
    margin: 4px 0 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.5;
}

.payment-sidebar {
    position: sticky;
    top: 24px;
}

.payment-summary {
    padding: 24px;
}


/* =========================================================
   SUCCESS PAGE
   ========================================================= */

.success-page {
    padding-top: 64px;
    padding-bottom: 64px;
}

.success-card {
    max-width: 620px;
    margin: 0 auto;
    padding: 40px;
    text-align: center;
}

.success-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin: 0 auto 24px;
    border-radius: 50%;
    background: var(--background);
    color: var(--accent);
    font-size: 34px;
    font-weight: 700;
}

.success-card__heading {
    margin-bottom: 28px;
}

.success-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 28px;
    text-align: left;
}

.success-detail {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--background);
}

.success-detail span {
    color: var(--text-secondary);
    font-size: 13px;
}

.success-detail strong {
    font-size: 15px;
}

.success-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
}

.success-note {
    margin: 24px 0 0;
    color: var(--text-secondary);
    font-size: 13px;
}


/* =========================================================
   HOW IT WORKS
   ========================================================= */

.how-it-works-page {
    padding-top: 48px;
}

.how-it-works-page__heading {
    max-width: 720px;
    margin-bottom: 40px;
}

.how-it-works-steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.how-it-works-step {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;
    padding: 24px;
}

.how-it-works-step__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: var(--background);
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
}

.how-it-works-step h2 {
    margin: 3px 0 8px;
    font-size: 19px;
}

.how-it-works-step p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
}

.how-it-works-categories {
    padding-right: 0;
    padding-left: 0;
    margin-top: 48px;
}

.how-it-works-categories .card-grid {
    margin-top: 24px;
}


/* =========================================================
   AUTH — LOGIN / REGISTER
   ========================================================= */

.auth-page {
    padding-top: 64px;
    padding-bottom: 64px;
}

.auth-layout {
    display: flex;
    justify-content: center;
}

.auth-card {
    width: 100%;
    max-width: 480px;
    padding: 32px;
}

.auth-card__heading {
    margin-bottom: 28px;
}

.auth-form {
    display: grid;
    gap: 20px;
}

.auth-form__options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
}

.auth-form__options a {
    color: var(--text);
}

.auth-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text-secondary);
    font-size: 14px;
    cursor: pointer;
}

.auth-checkbox input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
}

.auth-checkbox--terms {
    align-items: flex-start;
    line-height: 1.5;
}

.auth-card__footer {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 14px;
}

.auth-card__footer a {
    color: var(--text);
    font-weight: 600;
}


/* =========================================================
   PROFILE
   ========================================================= */

.profile-page {
    padding-top: 48px;
}

.profile-page__heading {
    margin-bottom: 32px;
}

.profile-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 32px;
    align-items: start;
}

.profile-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.profile-sidebar {
    position: sticky;
    top: 24px;
}

.profile-card {
    padding: 28px;
}

.profile-card__header {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-bottom: 24px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
}

.profile-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    flex: 0 0 72px;
    border-radius: 20px;
    background: var(--background);
    color: var(--text);
    font-size: 20px;
    font-weight: 700;
}

.profile-card__name {
    margin: 0 0 5px;
    font-size: 22px;
}

.profile-card__email {
    margin: 0;
    color: var(--text-secondary);
}

.profile-info {
    display: grid;
    gap: 0;
    margin-bottom: 24px;
}

.profile-info__item {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
}

.profile-info__item:first-child {
    padding-top: 0;
}

.profile-info__item span {
    color: var(--text-secondary);
}

.profile-info__item strong {
    text-align: right;
}

.profile-navigation {
    display: flex;
    flex-direction: column;
    padding: 8px;
}

.profile-navigation__item {
    padding: 13px 14px;
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
    transition: 0.2s ease;
}

.profile-navigation__item:hover,
.profile-navigation__item.is-active {
    background: var(--background);
}

.profile-navigation__item--danger {
    color: #B94A48;
}

.booking-preview-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 24px;
    padding: 20px;
}

.booking-preview-card__main {
    display: flex;
    align-items: center;
    gap: 16px;
}

.booking-preview-card__photo {
    width: 64px;
    height: 64px;
    overflow: hidden;
    flex: 0 0 64px;
    border-radius: 14px;
    background: var(--border);
}

.booking-preview-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.booking-preview-card__main h3 {
    margin: 0 0 5px;
}

.booking-preview-card__main p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
}

.booking-preview-card__details {
    display: flex;
    gap: 20px;
}

.booking-preview-card__details div {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.booking-preview-card__details span {
    color: var(--text-secondary);
    font-size: 12px;
}

.booking-preview-card__details strong {
    font-size: 14px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {
    .payment-layout,
    .profile-layout {
        grid-template-columns: 1fr;
    }

    .payment-sidebar,
    .profile-sidebar {
        position: static;
    }

    .how-it-works-steps {
        grid-template-columns: 1fr;
    }

    .booking-preview-card {
        grid-template-columns: 1fr;
    }

    .booking-preview-card__details {
        flex-wrap: wrap;
    }
}

@media (max-width: 600px) {
    .payment-method {
        grid-template-columns: 44px minmax(0, 1fr) auto;
    }

    .payment-method__icon {
        width: 44px;
    }

    .payment-form-row {
        grid-template-columns: 1fr;
    }

    .success-card {
        padding: 28px 20px;
    }

    .success-details {
        grid-template-columns: 1fr;
    }

    .success-actions {
        flex-direction: column;
    }

    .success-actions .button {
        width: 100%;
    }

    .auth-card {
        padding: 24px 20px;
    }

    .auth-form__options {
        align-items: flex-start;
        flex-direction: column;
    }

    .profile-card {
        padding: 22px;
    }

    .profile-card__header {
        align-items: flex-start;
    }

    .profile-info__item {
        flex-direction: column;
        gap: 5px;
    }

    .profile-info__item strong {
        text-align: left;
    }
}
