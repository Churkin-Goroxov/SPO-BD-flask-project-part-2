4. JS — src/static/js/main.js

Добавь в конец main.js:

/*
 * =========================================================
 * SCHEDULE PAGE
 * =========================================================
 */

document.addEventListener("DOMContentLoaded", () => {
    const schedulePage = document.querySelector(".schedule-page");

    if (!schedulePage) {
        return;
    }

    const dateButtons = schedulePage.querySelectorAll(
        "[data-schedule-date]"
    );

    const timeContainer = schedulePage.querySelector(
        "[data-schedule-times]"
    );

    const emptyMessage = schedulePage.querySelector(
        "[data-schedule-empty]"
    );

    const bookingDate = schedulePage.querySelector(
        "[data-booking-date]"
    );

    const bookingTime = schedulePage.querySelector(
        "[data-booking-time]"
    );

    const bookingDuration = schedulePage.querySelector(
        "[data-booking-duration]"
    );

    const bookingPrice = schedulePage.querySelector(
        "[data-booking-price]"
    );

    const serviceOptions = schedulePage.querySelectorAll(
        "[data-service-id]"
    );

    const submitButton = schedulePage.querySelector(
        "[data-schedule-submit]"
    );

    let selectedDate = null;
    let selectedTime = null;
    let selectedService = null;


    /*
     * Данные расписания.
     * Передаются Flask в data-атрибуты страницы.
     */

    const scheduleData = JSON.parse(
        schedulePage.dataset.schedule || "[]"
    );


    /*
     * Выбор услуги
     */

    if (serviceOptions.length > 0) {
        const firstService = serviceOptions[0];

        selectedService = {
            id: firstService.dataset.serviceId,
            name: firstService.dataset.serviceName,
            price: Number(firstService.dataset.servicePrice),
            duration: Number(firstService.dataset.serviceDuration),
        };

        updateServiceSummary();
    }


    serviceOptions.forEach((service) => {
        service.addEventListener("click", () => {
            serviceOptions.forEach((item) => {
                item.classList.remove("is-selected");
            });

            service.classList.add("is-selected");

            selectedService = {
                id: service.dataset.serviceId,
                name: service.dataset.serviceName,
                price: Number(service.dataset.servicePrice),
                duration: Number(service.dataset.serviceDuration),
            };

            updateServiceSummary();
        });
    });


    /*
     * Выбор даты
     */

    dateButtons.forEach((button) => {
        button.addEventListener("click", () => {
            dateButtons.forEach((item) => {
                item.classList.remove("is-selected");
            });

            button.classList.add("is-selected");

            selectedDate = button.dataset.scheduleDate;

            selectedTime = null;

            if (bookingDate) {
                bookingDate.textContent = selectedDate;
            }

            if (bookingTime) {
                bookingTime.textContent = "Выберите время";
            }

            renderTimes(selectedDate);
        });
    });


    /*
     * Рендер свободного времени
     */

    function renderTimes(date) {
        const day = scheduleData.find(
            (item) => item.date === date
        );

        if (!day || !timeContainer) {
            return;
        }

        timeContainer.innerHTML = "";

        const availableSlots = day.slots.filter(
            (slot) => slot.available
        );

        if (emptyMessage) {
            emptyMessage.hidden = availableSlots.length !== 0;
        }

        day.slots.forEach((slot) => {
            const button = document.createElement("button");

            button.type = "button";
            button.className =
                "button button--outline schedule-time";

            button.textContent = slot.time;

            button.dataset.time = slot.time;
            button.dataset.date = day.date;

            if (!slot.available) {
                button.disabled = true;
                button.classList.add("schedule-time--disabled");
            }

            if (slot.available) {
                button.addEventListener("click", () => {
                    selectTime(button);
                });
            }

            timeContainer.appendChild(button);
        });
    }


    /*
     * Выбор времени
     */

    function selectTime(button) {
        const buttons = timeContainer.querySelectorAll(
            ".schedule-time"
        );

        buttons.forEach((item) => {
            item.classList.remove("is-selected");
        });

        button.classList.add("is-selected");

        selectedTime = button.dataset.time;

        if (bookingTime) {
            bookingTime.textContent = selectedTime;
        }
    }


    /*
     * Обновление услуги
     */

    function updateServiceSummary() {
        if (!selectedService) {
            return;
        }

        if (bookingDuration) {
            bookingDuration.textContent =
                `${selectedService.duration} минут`;
        }

        if (bookingPrice) {
            bookingPrice.textContent =
                selectedService.price === 0
                    ? "Бесплатно"
                    : `${formatPrice(selectedService.price)} ₽`;
        }
    }


    /*
     * Продолжить
     */

    if (submitButton) {
        submitButton.addEventListener("click", () => {
            if (!selectedService) {
                showScheduleToast("Выберите услугу");
                return;
            }

            if (!selectedDate) {
                showScheduleToast("Выберите дату");
                return;
            }

            if (!selectedTime) {
                showScheduleToast("Выберите время");
                return;
            }

            const params = new URLSearchParams({
                specialist: "1",
                service: selectedService.id,
                date: selectedDate,
                time: selectedTime,
            });

            window.location.href =
                `/booking?${params.toString()}`;
        });
    }


    /*
     * Начальное состояние
     */

    if (dateButtons.length > 0) {
        selectedDate = dateButtons[0].dataset.scheduleDate;
        renderTimes(selectedDate);
    }


    /*
     * Вспомогательные функции
     */

    function formatPrice(price) {
        return new Intl.NumberFormat("ru-RU").format(price);
    }

    function showScheduleToast(message) {
        const toast = schedulePage.querySelector("[data-toast]");

        if (!toast) {
            return;
        }

        toast.textContent = message;
        toast.classList.add("is-visible");

        clearTimeout(showScheduleToast.timeout);

        showScheduleToast.timeout = setTimeout(() => {
            toast.classList.remove("is-visible");
        }, 2500);
    }
});

Но здесь есть один важный момент: scheduleData нужно передать в HTML, иначе JS не получит остальные дни. Поэтому в начало <section> добавь data-schedule.

Замени:

<section class="page-section schedule-page">

на:

<section
    class="page-section schedule-page"
    data-schedule='{{ schedule | tojson }}'
>
