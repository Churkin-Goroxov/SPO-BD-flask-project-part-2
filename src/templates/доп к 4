document.addEventListener("DOMContentLoaded", () => {
    const specialistPage = document.querySelector(".specialist-page");

    if (!specialistPage) {
        return;
    }

    /*
     * Избранное
     */

    const favoriteButton = specialistPage.querySelector(
        "[data-favorite-button]"
    );

    const favoriteIcon = specialistPage.querySelector(
        "[data-favorite-icon]"
    );

    if (favoriteButton && favoriteIcon) {
        favoriteButton.addEventListener("click", () => {
            const isActive = favoriteButton.classList.toggle("is-active");

            favoriteIcon.textContent = isActive ? "♥" : "♡";

            showToast(
                isActive
                    ? "Специалист добавлен в избранное"
                    : "Специалист удалён из избранного"
            );
        });
    }


    /*
     * Выбор услуги
     */

    const serviceOptions = specialistPage.querySelectorAll(
        "[data-service-id]"
    );

    const bookingService = specialistPage.querySelector(
        "[data-booking-service]"
    );

    const bookingDuration = specialistPage.querySelector(
        "[data-booking-duration]"
    );

    const bookingPrice = specialistPage.querySelector(
        "[data-booking-price]"
    );

    let selectedService = null;
    let selectedDate = null;
    let selectedTime = null;

    serviceOptions.forEach((service) => {
        service.addEventListener("click", () => {
            serviceOptions.forEach((item) => {
                item.classList.remove("is-selected");
            });

            service.classList.add("is-selected");

            selectedService = {
                id: service.dataset.serviceId,
                name: service.dataset.serviceName,
                price: Number(service.dataset.servicePrice),
                duration: Number(service.dataset.serviceDuration),
            };

            if (bookingService) {
                bookingService.textContent = selectedService.name;
            }

            if (bookingDuration) {
                bookingDuration.textContent =
                    `${selectedService.duration} минут`;
            }

            if (bookingPrice) {
                bookingPrice.textContent =
                    selectedService.price === 0
                        ? "Бесплатно"
                        : `${formatPrice(selectedService.price)} ₽`;
            }
        });
    });


    /*
     * Выбор времени
     */

    const scheduleSlots = specialistPage.querySelectorAll(
        ".schedule-slot:not(.schedule-slot--disabled)"
    );

    const bookingDate = specialistPage.querySelector(
        "[data-booking-date]"
    );

    const bookingTime = specialistPage.querySelector(
        "[data-booking-time]"
    );

    scheduleSlots.forEach((slot) => {
        slot.addEventListener("click", () => {
            scheduleSlots.forEach((item) => {
                item.classList.remove("is-selected");
            });

            slot.classList.add("is-selected");

            selectedDate = slot.dataset.date;
            selectedTime = slot.dataset.time;

            if (bookingDate) {
                bookingDate.textContent = selectedDate;
            }

            if (bookingTime) {
                bookingTime.textContent = selectedTime;
            }

            showToast(`Выбрано время: ${selectedTime}`);
        });
    });


    /*
     * Переход к записи
     */

    const bookingSubmit = specialistPage.querySelector(
        "[data-booking-submit]"
    );

    if (bookingSubmit) {
        bookingSubmit.addEventListener("click", () => {
            if (!selectedService) {
                showToast("Сначала выберите услугу");
                return;
            }

            if (!selectedDate || !selectedTime) {
                showToast("Выберите удобное время");
                return;
            }

            const params = new URLSearchParams({
                specialist: "1",
                service: selectedService.id,
                date: selectedDate,
                time: selectedTime,
            });

            window.location.href = `/booking?${params.toString()}`;
        });
    }


    /*
     * Подтверждение верификации
     */

    const verificationButtons = specialistPage.querySelectorAll(
        "[data-verification]"
    );

    const verificationModal = specialistPage.querySelector(
        "[data-verification-modal]"
    );

    const verificationText = specialistPage.querySelector(
        "[data-verification-text]"
    );

    const modalCloseButtons = specialistPage.querySelectorAll(
        "[data-modal-close]"
    );

    verificationButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const verification = button.dataset.verification;

            if (verificationText) {
                verificationText.textContent =
                    `${verification}. Данные специалиста были проверены сервисом LZORA.`;
            }

            if (verificationModal) {
                verificationModal.classList.add("is-open");
                verificationModal.setAttribute("aria-hidden", "false");
            }
        });
    });

    modalCloseButtons.forEach((button) => {
        button.addEventListener("click", closeVerificationModal);
    });

    function closeVerificationModal() {
        if (!verificationModal) {
            return;
        }

        verificationModal.classList.remove("is-open");
        verificationModal.setAttribute("aria-hidden", "true");
    }

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeVerificationModal();
        }
    });


    /*
     * Toast
     */

    let toastTimeout;

    function showToast(message) {
        const toast = specialistPage.querySelector("[data-toast]");

        if (!toast) {
            return;
        }

        clearTimeout(toastTimeout);

        toast.textContent = message;
        toast.classList.add("is-visible");
        toast.setAttribute("aria-hidden", "false");

        toastTimeout = setTimeout(() => {
            toast.classList.remove("is-visible");
            toast.setAttribute("aria-hidden", "true");
        }, 2500);
    }


    /*
     * Форматирование цены
     */

    function formatPrice(price) {
        return new Intl.NumberFormat("ru-RU").format(price);
    }
});
